# herdr-gh settings: copy to `$(herdr plugin config-dir jwarykowski.herdr-gh)/config.env`
# and keep only what you change. Run the restart action afterwards.

# seconds between polls (values expire after three)
HERDR_GH_INTERVAL=60

# sidebar token name, used as $gh in [ui.sidebar.spaces] rows
HERDR_GH_TOKEN=gh

# separator between parts, e.g. "·" or " "
HERDR_GH_SEPARATOR="│"

# prefix for draft PRs (open PRs use "#")
HERDR_GH_DRAFT="d"

# CI
HERDR_GH_PASSED="√"
HERDR_GH_FAILED="×"
HERDR_GH_RUNNING="•"

# review
HERDR_GH_APPROVED="+"
HERDR_GH_CHANGES="!"

# finished PRs
HERDR_GH_MERGED="↗"
HERDR_GH_CLOSED="†"
